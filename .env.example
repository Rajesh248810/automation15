# ====================================================================
# Meesho Order Automation & Hunter System - Environment Configuration
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your '.env' file to GitHub!
# ====================================================================

# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=2040
TELEGRAM_API_HASH=your_telegram_api_hash_here

# SMS Verification Provider API Keys
# OTPDoctor (https://otpdoctor.com)
OTPDOCTOR_API_KEY=your_otpdoctor_api_key_here

# PremiumOTP (https://premiumotp.pro)
PREMIUMOTP_API_KEY=your_premiumotp_api_key_here

# UOTP (https://uotp.in)
UOTP_API_KEY=your_uotp_api_key_here

# Remote Mini App / Web Backend Token
WEBAPP_TOKEN=your_webapp_auth_token_here
WEBAPP_BASE_URL=https://pricetrackerpro.fojadomain.fun

# Default fallback account session file
DEFAULT_ACCOUNT_FILE=meesho_account.json
